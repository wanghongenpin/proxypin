# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# zstandard 1.5.x 把 zstd C 源码拆到独立的 zstandard_native 包，其 pod prepare 脚本
# (sync_zstd.sh) 在 CocoaPods 物理解析插件 symlink 的工作目录下，无法向上遍历到项目的
# package_config，会报 "zstd source not found"。这里在 pod 解析前于插件包兄弟目录建好
# zstandard_native 链接，命中脚本的第一查找分支（$PLUGIN_ROOT/../zstandard_native）。
def link_zstandard_native
  require 'json'
  require 'uri'
  package_config = File.expand_path(File.join('..', '.dart_tool', 'package_config.json'), File.dirname(__FILE__))
  return unless File.exist?(package_config)

  native = JSON.parse(File.read(package_config))['packages']&.find { |pkg| pkg['name'] == 'zstandard_native' }
  return if native.nil?

  root_uri = native['rootUri'].to_s
  native_path = root_uri.start_with?('file:') ? URI(root_uri).path : root_uri
  return unless File.exist?(File.join(native_path, 'src', 'zstd', 'zstd.h'))

  link_path = File.join(File.dirname(native_path), 'zstandard_native')
  if File.symlink?(link_path)
    File.delete(link_path)
  elsif File.exist?(link_path)
    return # 同名的非符号链接实体，保留不动
  end
  File.symlink(native_path, link_path)
  puts "✅ 已预链接 zstandard_native -> #{native_path}"
rescue => e
  puts "⚠️ zstandard_native 预链接失败（不影响其他 pod）: #{e.message}"
end

link_zstandard_native

target 'Runner' do
  use_frameworks!
  use_modular_headers!
  
  pod 'SnapKit', '~> 5.0.1'
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # You can remove unused permissions here
      # for more information: https://github.com/Baseflow/flutter-permission-handler/blob/main/permission_handler_apple/ios/Classes/PermissionHandlerEnums.h
      # e.g. when you don't need camera permission, just add 'PERMISSION_CAMERA=0'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        ## dart: PermissionGroup.camera
        'PERMISSION_CAMERA=1',
        ## dart: PermissionGroup.photos
       # 'PERMISSION_PHOTOS=1',
      ]

      # Fix for AFNetworking private header warnings (netinet6/in6.h)
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
    end
  end

  # AFNetworking 4.0.1 直接 #import <netinet6/in6.h>，在新版 Xcode 下被判定为引用模块私有头。
  # netinet/in.h 已包含所需定义，移除该 import 即可。用 installer.sandbox.root 绝对路径，
  # 避免 pod install 的工作目录不在 ios/ 时相对 glob 命中 0 个文件而失效。
  Dir.glob(File.join(installer.sandbox.root, '**', '*.{m,mm}')).each do |file|
    content = File.read(file)
    if content.include?('#import <netinet6/in6.h>')
      File.chmod(0644, file)
      File.write(file, content.gsub(/#import <netinet6\/in6\.h>\r?\n/, ''))
      puts "✅ 已修复 #{file} 的 netinet6/in6.h 问题"
    end
  end
end
